---
layout: null
permalink: /sitemap.xml
---
{%- assign prefix = "" -%}
{%- unless site.active_lang == site.default_lang -%}
  {%- assign prefix = "/" | append: site.active_lang -%}
{%- endunless -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ prefix }}/</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
{%- for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ prefix }}{{ post.url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
{%- endfor -%}
{%- for page in site.pages -%}
  {%- if page.url != "/sitemap.xml" and page.url != "/404.html" and page.name != "feed.xml" and page.layout -%}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ prefix }}{{ page.url }}</loc>
  </url>
  {%- endif -%}
{%- endfor %}
</urlset>
